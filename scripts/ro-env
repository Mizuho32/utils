#!/usr/bin/env bash

rw=()
ro=()
noaccess=()
tmpfs=()
cmd=()
bwrap=
keep_env=
isolate=
net=
caps=

# "--" までをReadWritePaths、それ以降をコマンド
# --bwrap: systemd-run の代わりに bwrap で実行 (呼び出し元の子プロセスのまま動く)
# --keep-env: (--bwrap 時のみ) 呼び出し元の環境変数をそのまま引き継ぐ
# --noaccess a,b: 指定パスを隠す (ディレクトリは空に、ファイルは /dev/null に見える)
#   同じパスを ReadWritePaths にも指定した場合は隠す方が優先
#   --bwrap 時は配下の ReadWritePaths / --ro は見える。systemd-run 時は配下も含めて不可
# --ro a,b: (--bwrap 時のみ) --noaccess で隠した配下を読み取り専用で見せる
# --tmpfs a,b: (--bwrap 時のみ) 指定パスを書込み可能な空の tmpfs にする (終了で消える)
# --isolate: (--bwrap 時のみ) PID/IPC/UTS/cgroup/ネットワークを分離し、/dev を専用のものにする
# --net: (--isolate 時のみ) ネットワークの分離だけ解除する
# --caps A,B: (--isolate 時のみ、要 root) ユーザー名前空間を使わず本物の root で動かし、指定の capability だけ残す
#   指定できるのは CAP_CHOWN, CAP_DAC_OVERRIDE, CAP_FOWNER。実際の capability が一致しなければコマンドを実行しない
#   /proc は読み取り専用になる (/proc/sys 経由で root の権限を取られないように)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      cmd=("$@")
      break
      ;;
    --bwrap)
      bwrap=1
      shift
      ;;
    --keep-env)
      keep_env=1
      shift
      ;;
    --noaccess)
      IFS=, read -ra paths <<< "$2"
      noaccess+=("${paths[@]}")
      shift 2
      ;;
    --ro)
      IFS=, read -ra paths <<< "$2"
      ro+=("${paths[@]}")
      shift 2
      ;;
    --tmpfs)
      IFS=, read -ra paths <<< "$2"
      tmpfs+=("${paths[@]}")
      shift 2
      ;;
    --isolate)
      isolate=1
      shift
      ;;
    --net)
      net=1
      shift
      ;;
    --caps)
      caps=$2
      shift 2
      ;;
    *)
      rw+=("$1")
      shift
      ;;
  esac
done

if [[ -n $keep_env && -z $bwrap ]]; then
  echo "ro-env: --keep-env requires --bwrap" >&2
  exit 2
fi

if [[ ( ${#ro[@]} -gt 0 || ${#tmpfs[@]} -gt 0 || -n $isolate ) && -z $bwrap ]]; then
  echo "ro-env: --ro, --tmpfs and --isolate require --bwrap" >&2
  exit 2
fi

if [[ ( -n $net || -n $caps ) && -z $isolate ]]; then
  echo "ro-env: --net and --caps require --isolate" >&2
  exit 2
fi

# 実体を隠すためシンボリックリンクは解決する。存在しないパスは無視
resolved=()
for p in "${noaccess[@]}"; do
  p=$(realpath -e -- "$p" 2>/dev/null) && resolved+=("$p")
done
noaccess=("${resolved[@]}")
resolved=()
for p in "${tmpfs[@]}"; do
  p=$(realpath -e -- "$p" 2>/dev/null) && resolved+=("$p")
done
tmpfs=("${resolved[@]}")

if [[ -n $bwrap ]]; then
  # systemd-run に合わせて環境変数は user manager のもの + TERM/COLORTERM のみ
  envs=()
  [[ -z $keep_env ]] && while IFS= read -r line; do
    k=${line%%=*}
    v=${line#*=}
    if [[ $v =~ ^\$\'(.*)\'$ ]]; then
      printf -v v '%b' "${BASH_REMATCH[1]}"
    fi
    envs+=("--setenv" "$k" "$v")
  done < <(systemctl --user show-environment)
  if [[ -z $keep_env ]]; then
    envs=("--clearenv" "${envs[@]}")
    for k in TERM COLORTERM; do
      [[ -n ${!k:-} ]] && envs+=("--setenv" "$k" "${!k}")
    done
  fi

  # 親から順にマウントする (浅いパスが先、同じパスなら rw < ro < tmpfs < noaccess の順で後のものが上に載る)
  args=()
  remount=()
  while IFS=$'\t' read -r _ _ kind p; do
    case $kind in
      rw) args+=("--bind-try" "$p" "$p") ;;
      ro) args+=("--ro-bind-try" "$p" "$p") ;;
      tmpfs) args+=("--tmpfs" "$p") ;;
      noaccess)
        if [[ -d $p ]]; then
          args+=("--tmpfs" "$p")
          # 配下のマウントポイント作成後に読み取り専用にする
          remount+=("--remount-ro" "$p")
        else
          args+=("--ro-bind" "/dev/null" "$p")
        fi
        ;;
    esac
  done < <({
    for p in "${rw[@]}"; do p=${p%/}; printf '%s\t0\trw\t%s\n' "${#p}" "${p:-/}"; done
    for p in "${ro[@]}"; do p=${p%/}; printf '%s\t1\tro\t%s\n' "${#p}" "${p:-/}"; done
    for p in "${tmpfs[@]}"; do printf '%s\t2\ttmpfs\t%s\n' "${#p}" "$p"; done
    for p in "${noaccess[@]}"; do printf '%s\t3\tnoaccess\t%s\n' "${#p}" "$p"; done
  } | sort -t $'\t' -s -k1,1n -k2,2n)
  dev=("--dev-bind" "/dev" "/dev")
  unshare=()
  if [[ -n $isolate ]]; then
    dev=("--dev" "/dev")
    unshare=("--unshare-ipc" "--unshare-pid" "--unshare-uts" "--unshare-cgroup-try")
    [[ -z $net ]] && unshare+=("--unshare-net")
  fi

  userns=("--unshare-user" "--disable-userns")
  if [[ -n $caps ]]; then
    # bwrap の --cap-add は root だと権限を絞らないことがあるので、全権限で入って setpriv で落とす
    userns=("--cap-add" "ALL")
    remount+=("--remount-ro" "/proc")
    mask=0
    keep=-all
    IFS=, read -ra cap_list <<< "$caps"
    for c in "${cap_list[@]}"; do
      case $c in
        CAP_CHOWN) bit=0 ;;
        CAP_DAC_OVERRIDE) bit=1 ;;
        CAP_FOWNER) bit=3 ;;
        *)
          echo "ro-env: unsupported capability: $c" >&2
          exit 2
          ;;
      esac
      mask=$((mask | 1 << bit))
      name=${c#CAP_}
      keep+=",+${name,,}"
    done
    # uid 0 は exec で bounding set まで権限が戻るので、それ以外に権限が残っていないことも確認する
    guard='want=$1; shift
while read -r k v; do
  case $k in
    CapPrm:|CapEff:|CapBnd:) [[ $v == "$want" ]] ;;
    CapInh:|CapAmb:) [[ $v == 0000000000000000 ]] ;;
    *) continue ;;
  esac || { echo "ro-env: capability check failed: $k $v" >&2; exit 126; }
done < /proc/self/status
exec "$@"'
    cmd=(/usr/bin/setpriv "--bounding-set=$keep" --inh-caps=-all -- /usr/bin/bash -c "$guard" ro-env "$(printf '%016x' "$mask")" "${cmd[@]}")
  fi

  # ProtectSystem=strict + BindReadOnlyPaths=$HOME 相当: / 全体を ro、/dev /proc は使えるように
  exec bwrap \
    --ro-bind / / \
    "${dev[@]}" \
    --proc /proc \
    "${userns[@]}" \
    "${unshare[@]}" \
    "${args[@]}" \
    "${remount[@]}" \
    "${envs[@]}" \
    --chdir "$PWD" \
    --die-with-parent \
    -- "${cmd[@]}"
fi

# systemd-run 実行
args=()
for p in "${rw[@]}"; do
  args+=("-p" "ReadWritePaths=-$p")
done
for p in "${noaccess[@]}"; do
  args+=("-p" "InaccessiblePaths=-$p")
done

systemd-run -P --user --pty --working-directory=$PWD \
  -p ProtectSystem=strict \
  -p BindReadOnlyPaths="$HOME" \
  "${args[@]}" \
  "${cmd[@]}"

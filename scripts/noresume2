#!/usr/bin/env ruby
#coding: utf-8

require 'open3'

RULES_DIR = '/etc/udev/rules.d'

def abort_with(message)
  warn message
  exit 1
end

def run!(*command, stdin_data: nil)
  out, status = Open3.capture2e(*command, stdin_data: stdin_data)
  return out if status.success?

  abort_with <<~EOF
    Command failed: #{command.join(' ')}
    #{out}
  EOF
end

def usage
  <<~EOF
    Usage:
      noresume2 [lsusb query]

    Examples:
      noresume2 elecom
      noresume2 056e:0107

    If you omit the query, the script shows every lsusb entry and asks you to choose one.
  EOF
end

def list_usb_devices
  run!('lsusb').lines.filter_map do |line|
    line = line.strip
    match = line.match(/\ABus (\d{3}) Device (\d{3}): ID ([0-9a-f]{4}):([0-9a-f]{4})\s*(.*)\z/i)
    next unless match

    {
      line: line,
      bus: match[1],
      device: match[2],
      vendor: match[3].downcase,
      product: match[4].downcase,
      label: match[5].strip,
    }
  end
end

def choose_device(devices)
  abort_with('No USB devices matched.') if devices.empty?
  return devices.first if devices.size == 1

  puts 'Matched USB devices:'
  devices.each.with_index(1) do |device, index|
    puts format('%2d. %s', index, device[:line])
  end

  print 'Select USB number: '
  selected = STDIN.gets.to_s.strip
  index = Integer(selected, 10)
  device = devices[index - 1]
  return device if device

  abort_with('Invalid selection.')
rescue ArgumentError
  abort_with('Invalid selection.')
end

def read_udev_properties(bus, device)
  run!('udevadm', 'info', "--name=/dev/bus/usb/#{bus}/#{device}", '--query=property')
    .lines
    .map(&:strip)
    .filter_map { |line| line.split('=', 2) if line.include?('=') }
    .to_h
end

if ARGV.include?('-h') || ARGV.include?('--help')
  puts usage
  exit 0
end

devices = list_usb_devices
query = ARGV.join(' ').strip.downcase

matches =
  if query.empty?
    devices
  else
    devices.select do |device|
      device[:line].downcase.include?(query) || "#{device[:vendor]}:#{device[:product]}".include?(query)
    end
  end

selected = choose_device(matches)
properties = read_udev_properties(selected[:bus], selected[:device])
devpath = properties['DEVPATH'] || abort_with("Could not resolve DEVPATH for #{selected[:line]}")
kernel_name = File.basename(devpath)
wakeup_path = "/sys/bus/usb/devices/#{kernel_name}/power/wakeup"

abort_with("Wakeup path not found: #{wakeup_path}") unless File.exist?(wakeup_path)

rule_name = "90-noresume-#{selected[:vendor]}-#{selected[:product]}-#{kernel_name}.rules"
rule_path = File.join(RULES_DIR, rule_name)
tmp_path = "/tmp/#{rule_name}.#{Process.pid}"

rule_body = <<~EOF
  # Generated by scripts/noresume2 from:
  # #{selected[:line]}
  ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNEL=="#{kernel_name}", ATTR{idVendor}=="#{selected[:vendor]}", ATTR{idProduct}=="#{selected[:product]}", RUN+="/bin/sh -c 'echo disabled > #{wakeup_path}'"
EOF

File.write(tmp_path, rule_body)

puts "Selected USB : #{selected[:line]}"
puts "Resolved path: #{kernel_name}"
puts "Wakeup file  : #{wakeup_path}"
puts "Temp rule    : #{tmp_path}"
puts
puts rule_body

print "Create #{rule_path}? [y/N]: "
answer = STDIN.gets.to_s.strip.downcase

unless %w[y yes].include?(answer)
  puts "Skipped. Rule draft remains at #{tmp_path}"
  exit 0
end

run!('sudo', 'install', '-Dm644', tmp_path, rule_path)
run!('sudo', 'tee', wakeup_path, stdin_data: "disabled\n")
run!('sudo', 'udevadm', 'control', '--reload-rules')
run!('sudo', 'udevadm', 'trigger', '--subsystem-match=usb', '--action=add')

File.delete(tmp_path) if File.exist?(tmp_path)

puts "Created #{rule_path}"
puts "Disabled wakeup at #{wakeup_path}"
